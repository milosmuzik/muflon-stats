# Zkopíruj do .env.local pro lokální vývoj (soubor je v .gitignore,
# skutečné hodnoty se necommitují).

# Přihlašovací údaje k Upstash Redis. Když si Vercel projekt propojíš
# s Upstash databází přes záložku Storage, doplní jednu z těchto dvojic
# proměnných automaticky - zkopíruj hodnoty odsud z Vercel dashboardu
# (Settings → Environment Variables) nebo přímo z Upstash konzole.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativní názvy, které appka taky umí přečíst (viz lib/redis.js):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_REST_URL=
# REDIS_REST_TOKEN=

# Volitelné: ID streamu na Zeno.fm. Když se nenastaví, použije se výchozí
# stream Rádia Muflon (wjj5yshttnitv).
ZENO_STREAM_ID=

# Volitelné: tajný řetězec pro zabezpečení /api/poll. Když se nastaví,
# endpoint vyžaduje ?secret=<hodnota> v URL (viz README, sekce 3).
CRON_SECRET=
